---
import { getSite } from '../lib/site';
import { whatsappUrl, ORDER_MESSAGE } from '../lib/whatsapp';

interface Props {
  label?: string;
  message?: string;
}

const {
  label = 'Commander',
  message = ORDER_MESSAGE,
} = Astro.props;
const site = await getSite();
const whatsappConfirmed =
  Boolean(site.whatsapp) && !site.toConfirm.includes('whatsapp');
const href = whatsappConfirmed
  ? whatsappUrl(site.whatsapp, message)
  : undefined;
---

{href && (
  <a
    class="btn btn--whatsapp"
    href={href}
    rel="noopener noreferrer"
    target="_blank"
  >
    {label}
  </a>
)}
