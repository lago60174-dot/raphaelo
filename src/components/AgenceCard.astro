---
import { agenceGallery } from '../lib/agences';
import Placeholder from './Placeholder.astro';
import { pickCover, serviceLabels, type Agence } from '../lib/agences';
import { content } from '../lib/content';
import { t } from '../lib/i18n';

interface Props {
  agence: Agence;
}
const { agence } = Astro.props;
const cover = pickCover(agence);
const gallery = agenceGallery(agence);
const services = serviceLabels(agence);
---

<li>
  <div class="media" data-carousel>
    {gallery.length > 0 ? (
      <>
        <img
          class="agency-photo"
          src={cover?.thumb ?? gallery[0].thumb}
          alt={cover?.alt ?? gallery[0].alt}
          loading="lazy"
          decoding="async"
          data-slides={JSON.stringify(
            gallery.map((image) => ({ src: image.thumb, alt: image.alt })),
          )}
        />
        {gallery.length > 1 && (
          <div class="photo-controls">
            <button
              type="button"
              data-prev
              aria-label={`Photo précédente : ${agence.nom}`}
            >
              ‹
            </button>
            <span data-count>1 / {gallery.length}</span>
            <button
              type="button"
              data-next
              aria-label={`Photo suivante : ${agence.nom}`}
            >
              ›
            </button>
          </div>
        )}
      </>
    ) : (
      <Placeholder />
    )}
  </div>
  <h3>
    <a href={`/agences/${agence.slug}`}>{agence.nom}</a>
  </h3>
  <p class="where">
    {agence.quartier} · {agence.repere}
  </p>
  {services.length > 0 && <p class="services">{services.join(' · ')}</p>}
  <p class="more" aria-hidden="true">
    {t(content.cta.voirAgence)} →
  </p>
  <a
    class="route-link"
    href={agence.mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Ouvrir l’itinéraire pour ${agence.nom}`}
  >
    <span aria-hidden="true">⌖</span> Itinéraire Google Maps
  </a>
</li>

<style>
  li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.8rem;
    list-style: none;
    border: 1px solid rgb(40 20 20 / 10%);
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 8px 26px rgb(40 20 20 / 5%);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }
  li:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 42px rgb(40 20 20 / 11%);
    border-color: color-mix(in srgb, var(--color-primary) 35%, transparent);
  }
  .media {
    margin-bottom: 0.5rem;
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background: #f4efeb;
  }
  .agency-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 18px;
    transition: transform 0.4s ease;
  }
  li:hover .agency-photo {
    transform: scale(1.035);
  }
  .photo-controls {
    z-index: 2;
    position: absolute;
    inset: auto 0.6rem 0.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }
  .photo-controls button {
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgb(255 255 255 / 65%);
    border-radius: 50%;
    background: rgb(255 255 255 / 92%);
    color: var(--color-text);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 3px 12px rgb(0 0 0 / 12%);
    transition:
      transform 0.15s,
      background 0.15s;
  }
  .photo-controls button:hover {
    transform: scale(1.08);
    background: #fff;
  }
  .photo-controls span {
    pointer-events: none;
    background: rgb(25 20 20 / 72%);
    color: #fff;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 800;
  }
  h3 {
    margin: 0;
    font-size: 1.25rem;
  }
  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:focus-visible::after {
    outline: 3px solid var(--color-primary-dark);
    outline-offset: 2px;
    border-radius: var(--radius-card);
  }
  p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .route-link {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 42px;
    margin-top: 0.35rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid rgb(40 20 20 / 14%);
    border-radius: 999px;
    color: var(--color-primary-dark);
    background: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 800;
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }
  .route-link:hover {
    background: color-mix(in srgb, var(--color-primary) 7%, #fff);
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }
  .more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: auto;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    font-weight: 800;
    transition:
      filter 0.2s,
      transform 0.2s;
  }
  li:hover .more {
    filter: brightness(1.08);
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-carousel]')
    .forEach((carousel) => {
      const image = carousel.querySelector<HTMLImageElement>('.agency-photo');
      const count = carousel.querySelector<HTMLElement>('[data-count]');
      const prev = carousel.querySelector<HTMLButtonElement>('[data-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-next]');
      if (!image || !image.dataset.slides) return;
      let slides: { src: string; alt: string }[] = [];
      try {
        slides = JSON.parse(image.dataset.slides);
      } catch {
        return;
      }
      if (slides.length < 2) return;
      let index = slides.findIndex(
        (slide) =>
          slide.src === image.src || slide.src === new URL(image.src).pathname,
      );
      if (index < 0) index = 0;
      const show = (nextIndex: number) => {
        index = (nextIndex + slides.length) % slides.length;
        image.src = slides[index].src;
        image.alt = slides[index].alt;
        if (count) count.textContent = `${index + 1} / ${slides.length}`;
      };
      prev?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        show(index - 1);
      });
      next?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        show(index + 1);
      });
    });
</script>
