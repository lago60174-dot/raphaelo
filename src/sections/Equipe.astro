---
import { content } from '../lib/content';
import { t } from '../lib/i18n';
---

<section class="container">
  <h2>{t(content.sections.equipe.titre)}</h2>
  <p>{t(content.sections.equipe.texte)}</p>
  <figure>
    <img
      src="/images/livreur-moto-raphaelo.webp"
      alt="Illustration d'un livreur Raphaëlo en uniforme rouge sur son scooter"
      width="270"
      height="225"
      loading="lazy"
      decoding="async"
    />
  </figure>
</section>

<style>
  section {
    padding-top: 3rem;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }
  p {
    margin: 0 0 1rem;
    max-width: 40rem;
  }
  figure {
    margin: 0;
    max-width: 270px;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgb(199 20 21 / 12%);
    border-radius: 1.5rem;
    box-shadow: 0 18px 44px rgb(55 24 20 / 14%);
  }
</style>
