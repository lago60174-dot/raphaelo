---
interface Props {
  ratio?: string;
}
const { ratio = '4 / 3' } = Astro.props;
---

<!-- Visuel de remplacement sobre aux couleurs de la marque : pas de fausse photo. -->
<div class="ph" style={`aspect-ratio:${ratio}`} aria-hidden="true">
  <svg
    viewBox="0 0 100 100"
    width="40%"
    fill="none"
    stroke="currentColor"
    stroke-width="4"
    stroke-linecap="round"
  >
    <circle cx="50" cy="50" r="34" />
    <path d="M50 16v68M16 50h68M26 26l48 48M74 26 26 74" opacity=".55" />
  </svg>
</div>

<style>
  .ph {
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 480px;
    border-radius: var(--radius-card);
    background: var(--color-primary-dark);
    color: var(--color-background);
  }
</style>
